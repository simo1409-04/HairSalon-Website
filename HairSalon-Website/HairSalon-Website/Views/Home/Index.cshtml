@using System.Globalization
@{
    ViewData["Title"] = "Graphite Barber Studio";
    List<ServiceView> services = ViewBag.Services as List<ServiceView> ?? new List<ServiceView>();
    List<string> homeGalleryUrls = (ViewBag.HomeGallery as List<string> ?? new List<string>()).Take(5).ToList();
}

<div class="graphite-home">

    <section class="graphite-hero" aria-labelledby="hero-title">
        <div class="graphite-hero__shade" aria-hidden="true"></div>

        <div class="graphite-shell graphite-hero__content">
          

            <h1 id="hero-title">Точност във всеки <em>детайл.</em></h1>

            <p class="graphite-hero__text">
                Класически барбер ритуал, модерни техники и отношение,
                което започва още с първия разговор.
            </p>

            <a class="graphite-booking" href="/Reservation/Create">Запази час <span aria-hidden="true">→</span></a>
        </div>

        <p class="graphite-hero__side-label" aria-hidden="true">Graphite Barber Studio · Est. 2026</p>
    </section>

    <section class="graphite-intro" aria-labelledby="intro-title">
        <div class="graphite-shell graphite-intro__grid">
            <p class="graphite-kicker graphite-kicker--dark">За студиото</p>
            <div>
                <h2 id="intro-title">Изградена визия.<br /><em>Естествено усещане.</em></h2>
                <p>
                    Тук всяка прическа се изгражда спрямо формата, косата и начина,
                    по който искаш да се чувстваш, когато излезеш от стола.
                </p>
            </div>
        </div>
    </section>

    <section class="graphite-services" id="services" aria-labelledby="services-title">
        <div class="graphite-shell graphite-services__grid">
            <div class="graphite-services__heading">
                <p class="graphite-kicker graphite-kicker--dark">Услуги и цени</p>
                <h2 id="services-title">Грижа до последния <em>детайл.</em></h2>
                <p>Избери услуга, за да прочетеш повече за нея.</p>
            </div>

            <div class="graphite-services__list">
                @if (services.Count == 0)
                {
                    <p class="graphite-services__empty">В момента няма добавени услуги.</p>
                }
                else
                {
                    @foreach (var service in services)
                    {
                        <details class="graphite-service">
                            <summary class="graphite-service__summary">
                                <span class="graphite-service__name">@service.Name</span>
                                <span class="graphite-service__price">@service.Price.ToString("0.00", CultureInfo.GetCultureInfo("bg-BG")) eur.</span>
                                <span class="graphite-service__icon" aria-hidden="true">+</span>
                            </summary>
                            <p class="graphite-service__details">
                                @(string.IsNullOrWhiteSpace(service.Details)
                                    ? "Подробности за услугата ще добавим скоро."
                                    : service.Details)
                            </p>
                        </details>
                    }
                }
            </div>
        </div>
    </section>

    <section class="graphite-gallery" aria-labelledby="gallery-title">
        <div class="graphite-shell">
            <div class="graphite-gallery__heading">
                <div>
                    <p class="graphite-kicker graphite-kicker--dark">Нашата работа</p>
                    <h2 id="gallery-title">Прически с характер.</h2>
                </div>
            </div>

            <div class="graphite-gallery__grid" aria-label="Галерия с прически">
                @foreach (var imageUrl in homeGalleryUrls)
                {
                    <figure class="gallery-card">
                        <img src="@imageUrl" alt="Работа от Graphite Barber Studio" loading="lazy" decoding="async" />
                    </figure>
                }
            </div>
        </div>
    </section>
</div>
