@using System.Globalization
@{
    ViewData["Title"] = "Graphite Barber Studio";
    List<ServiceView> services = ViewBag.Services as List<ServiceView> ?? new List<ServiceView>();
    List<string> homeGalleryUrls = (ViewBag.HomeGallery as List<string> ?? new List<string>()).Take(5).ToList();
}

<div class="graphite-home">

    <section class="graphite-hero" aria-labelledby="hero-title">
        <div class="graphite-hero__shade" aria-hidden="true"></div>

        <div class="graphite-shell graphite-hero__content">
          

            <h1 id="hero-title">Изглеждай добре.<br /><em>Чувствай се още по-добре.</em></h1>

            <p class="graphite-hero__text">
                Защото първото впечатление започва от визията.
            </p>

            <a class="graphite-booking" href="/Reservation/Create">Запази час <span aria-hidden="true">→</span></a>
        </div>

        <p class="graphite-hero__side-label" aria-hidden="true">Graphite Barber Studio · Est. 2026</p>
    </section>

    <section class="graphite-statement" aria-labelledby="statement-title">
        <div class="graphite-shell graphite-statement__inner">
            <h2 id="statement-title" data-reveal="left">Перфектната прическа не е лукс, а <em>отношение към себе си.</em></h2>
            <div class="graphite-statement__copy" data-reveal="right">
                <p>
                    В GRAPHITE BARBER STUDIO ще откриеш професионално подстригване,
                    прецизно оформяне на брадата и индивидуален подход, съобразен
                    с твоето излъчване и стил.
                </p>
                <p>
                    От класическата визия до най-актуалните тенденции – ние се грижим
                    да си тръгнеш с повече от добра прическа. Със самочувствие.
                </p>
            </div>
        </div>
    </section>

    <section class="graphite-intro" aria-labelledby="intro-title">
        <div class="graphite-shell graphite-intro__content">
            <h2 id="intro-title" data-reveal="left">За <em>студиото</em></h2>
            <p class="graphite-intro__lead" data-reveal="up">Стил, който говори вместо теб.</p>
            <p class="graphite-intro__accent" data-reveal="up">Прецизност, характер и индивидуален подход.</p>
            <p class="graphite-intro__text" data-reveal="up">
                В GRAPHITE BARBER STUDIO всяка визия има значение. Съчетаваме
                професионализъм, внимание към детайла и усет към модерния мъжки стил,
                за да създадем визия, която подчертава твоя характер. Защото добрата
                прическа не е просто външен вид – тя е самочувствие.
            </p>
        </div>
    </section>

    <section class="graphite-services" id="services" aria-labelledby="services-title">
        <div class="graphite-shell graphite-services__grid">
            <div class="graphite-services__heading" data-reveal="left">
                <p class="graphite-kicker graphite-kicker--dark">Услуги и цени</p>
                <h2 id="services-title">Грижа до последния <em>детайл.</em></h2>
                <p>Избери услуга, за да прочетеш повече за нея.</p>
            </div>

            <div class="graphite-services__list" data-reveal="right">
                @if (services.Count == 0)
                {
                    <p class="graphite-services__empty">В момента няма добавени услуги.</p>
                }
                else
                {
                    @foreach (var service in services)
                    {
                        <details class="graphite-service">
                            <summary class="graphite-service__summary">
                                <span class="graphite-service__name">@service.Name</span>
                                <span class="graphite-service__price">@service.Price.ToString("0.00", CultureInfo.GetCultureInfo("bg-BG")) eur.</span>
                                <span class="graphite-service__icon" aria-hidden="true">+</span>
                            </summary>
                            <p class="graphite-service__details">
                                @(string.IsNullOrWhiteSpace(service.Details)
                                    ? "Подробности за услугата ще добавим скоро."
                                    : service.Details)
                            </p>
                        </details>
                    }
                }
            </div>
        </div>
    </section>

    <section class="graphite-gallery" aria-labelledby="gallery-title">
        <div class="graphite-shell">
            <div class="graphite-gallery__heading">
                <div>
                    <p class="graphite-kicker graphite-kicker--dark">Нашата работа</p>
                    <h2 id="gallery-title">Прически с характер.</h2>
                </div>
            </div>

            <div class="graphite-gallery__grid" aria-label="Галерия с прически">
                @for (var index = 0; index < homeGalleryUrls.Count; index++)
                {
                    var imageUrl = homeGalleryUrls[index];
                    var revealDirection = index % 2 == 0 ? "left" : "right";

                    <figure class="gallery-card" data-safe-reveal="@revealDirection">
                        <img src="@imageUrl" alt="Работа от Graphite Barber Studio" loading="lazy" decoding="async" />
                    </figure>
                }
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/home-scroll-reveal.js" asp-append-version="true"></script>
}
