
@using System.Globalization
@model HairSalon.Data.Models.Reservation

@{
    ViewData["Title"] = "Успешна резервация";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/reservation-result.css"
          asp-append-version="true" />
}

<main class="reservation-result-page">
    <div class="reservation-success-notification"
         role="status"
         aria-live="polite">
        <span class="reservation-success-notification__icon"
              aria-hidden="true">✓</span>

        <p>Резервацията беше направена успешно!</p>
    </div>

    <div class="reservation-result-shell">

        <section class="reservation-result-card reservation-result-card--success">
            <div class="reservation-result-icon" aria-hidden="true">✓</div>

            <p class="reservation-result-kicker">
                Graphite Barber Studio
            </p>

            <h1>Резервация за <em>@Model.ClientName.</em></h1>

            <p class="reservation-result-intro">
                По-долу са всички детайли за запазения час.
            </p>

            <div class="reservation-result-details">
                <div class="reservation-result-detail">
                    <span>Фризьор</span>
                    <strong>@Model.HairDresser.Name</strong>
                </div>

                <div class="reservation-result-detail">
                    <span>Дата</span>
                    <strong>
                        @Model.ReservationDate.ToString(
                            "dddd, dd.MM.yyyy",
                            CultureInfo.GetCultureInfo("bg-BG"))
                    </strong>
                </div>

                <div class="reservation-result-detail">
                    <span>Час</span>
                    <strong>
                        @Model.ReservationTime.ToString("HH:mm") –
                        @Model.ReservationTime.AddMinutes(45).ToString("HH:mm")
                    </strong>
                </div>
            </div>

            <section class="reservation-result-services"
                     aria-labelledby="services-title">
                <h2 id="services-title">Избрани услуги</h2>

                <ul>
                    @foreach (var service in Model.Services)
                    {
                        <li>
                            <span>@service.Name</span>
                            <strong>
                                @service.Price.ToString(
                                    "0.00",
                                    CultureInfo.GetCultureInfo("bg-BG")) eur.
                            </strong>
                        </li>
                    }
                </ul>
            </section>

            <div class="reservation-result-total">
                <span>Обща цена</span>

                <strong>
                    @Model.TotalPrice.ToString(
                        "0.00",
                        CultureInfo.GetCultureInfo("bg-BG")) eur.
                </strong>
            </div>

            <div class="reservation-result-actions">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="result-button result-button--secondary">
                    Към началната страница
                </a>

                <a asp-controller="Reservation"
                   asp-action="Create"
                   class="result-button result-button--primary">
                    Нова резервация <span aria-hidden="true">→</span>
                </a>
            </div>
        </section>

    </div>
</main>
