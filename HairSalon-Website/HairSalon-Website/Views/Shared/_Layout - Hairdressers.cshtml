
<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Graphite Barber Studio</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/HairSalon_Website.styles.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <partial name="_TempDataNotifications" />

    <header class="site-header">
        <nav class="site-navigation">

            <button class="menu-toggle"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainMenu"
                    aria-controls="mainMenu"
                    aria-expanded="false"
                    aria-label="Отвори меню">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <div class="site-logo">
                GRAPHITE <span>BARBER STUDIO</span>
            </div>

            <div class="collapse site-menu" id="mainMenu">
                <ul>
                    <li>
                        <a asp-controller="Home"
                           asp-action="IndexAdmin">
                            Начало(изглед за клиенти)
                        </a>
                    </li>

                  

                     <li>
                        <a asp-controller="Reservation"
                           asp-action="Create">
                            Запази час(изглед за клиенти)
                        </a>
                    </li>

                    <li>
                        <a asp-controller=""
                           asp-action="">

                            Галерия(изглед за клиенти)
                        </a>
                    </li>

                         <li>
                        <a asp-controller="Hairdresser"
                           asp-action="All">

                            Екип(изглед за клиенти)
                        </a>
                    </li>
                </ul>

                <partial name="Layout__LoginPartial_Client" />
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-footer__content">

            <div class="site-footer__location">
                <p class="site-footer__title">Местоположение</p>
                <div class="site-footer__map-preview">
                    <iframe title="Карта на Graphite Barber Studio в Перник"
                            src="https://www.openstreetmap.org/export/embed.html?bbox=23.106001%2C42.602111%2C23.112001%2C42.605111&amp;layer=mapnik&amp;marker=42.603611%2C23.109001"
                            loading="lazy"
                            tabindex="-1"></iframe>
                    <a class="site-footer__map-link"
                       href="https://www.google.com/maps/search/?api=1&amp;query=42.603611%2C23.109001"
                       target="_blank" rel="noopener noreferrer">
                        <span class="site-footer__map-caption">
                            Перник, кв. Изток, ул. Благой Гебрев 32А
                            <span class="site-footer__map-action">Отвори картата <span aria-hidden="true">↗</span></span>
                        </span>
                    </a>
                </div>
            </div>

            <div class="site-footer__contacts">
                <p class="site-footer__title">Контакти</p>

                <a href="tel:+359887812363">
                    0887812363
                </a>

                <nav class="site-footer__socials" aria-label="Социални мрежи">
                    <a href="https://www.instagram.com/graphite.barber.studio/" target="_blank" rel="noopener noreferrer">Instagram</a>
                    <a href="https://www.tiktok.com/@@graphite.barber.studio" target="_blank" rel="noopener noreferrer">TikTok</a>
                    <a href="https://www.facebook.com/profile.php?id=100067407116841" target="_blank" rel="noopener noreferrer">Facebook</a>
                </nav>
            </div>

           <div class="site-footer__hours">
                <p class="site-footer__title">
                    Работно време
                </p>

                <p>
                    Сряда – Неделя
                    <br />
                    10:00 – 20:00
                </p>

 <p class="site-footer__title">  Почивни дни<p>
                    
     <P>
                    Понеделник и вторник
                </p>
            </div>

        </div>

        <div class="site-footer__bottom">
            <p>
                © @DateTime.Now.Year Graphite Barber Studio
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
