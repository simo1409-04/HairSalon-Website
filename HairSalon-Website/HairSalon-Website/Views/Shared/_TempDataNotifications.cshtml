@{
    var messages = new[]
    {
        new { Key = "ErrorMessage", Kind = "error", DurationMs = 5000 },
        new { Key = "ErrorSaving", Kind = "error", DurationMs = 5000 },
        new { Key = "SucsessEdit", Kind = "success", DurationMs = 5000 },
        new { Key = "SucsessMessage", Kind = "success", DurationMs = 5000 },
        new { Key = "ErrorService", Kind = "error", DurationMs = 12000 },
        new { Key = "ErrorServiceNotFound", Kind = "error", DurationMs = 12000 },
        new { Key = "SucsessServiceAdded", Kind = "success", DurationMs = 12000 },
        new { Key = "SucsessEditetServiceA", Kind = "success", DurationMs = 12000 },
        new { Key = "SucsessDeleteService", Kind = "success", DurationMs = 12000 },
        new { Key = "ErrorWrongFormat", Kind = "error", DurationMs = 12000 },
        new { Key = "ErrorSavingHairDresser", Kind = "error", DurationMs = 12000 },
        new { Key = "IdNotFoundEdit", Kind = "error", DurationMs = 12000 },
        new { Key = "FileNotCreated", Kind = "error", DurationMs = 12000 },
        new { Key = "SucsessSavingHairDresser", Kind = "success", DurationMs = 12000 },
        new { Key = "SucsessEditedHairDresser", Kind = "success", DurationMs = 12000 },
        new { Key = "DatabaseErrorDelete", Kind = "error", DurationMs = 12000 },
        new { Key = "SucsessDelete", Kind = "success", DurationMs = 12000 }
    };
}

<div class="site-notifications">
    @foreach (var item in messages)
    {
        var message = TempData[item.Key]?.ToString();
        if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="site-notification site-notification--@item.Kind"
                 data-tempdata-notification
                 data-tempdata-duration="@item.DurationMs"
                 role="@(item.Kind == "error" ? "alert" : "status")">
                <span class="site-notification__icon" aria-hidden="true">@(item.Kind == "error" ? "!" : "✓")</span>
                <p class="site-notification__message">@message</p>
            </div>
        }
    }
</div>
